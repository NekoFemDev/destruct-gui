# The GUI's name, icon, and launcher entry are all "destruct-gui".
pkgname=destruct-gui
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyboard-first desktop GUI for the DeStruct multi-format decompiler'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/destruct-gui "$pkgdir/usr/bin/destruct-gui"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/destruct-gui.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/destruct-gui.svg"
  install -Dm644 "$startdir/destruct-gui.desktop" \
    "$pkgdir/usr/share/applications/destruct-gui.desktop"
}
